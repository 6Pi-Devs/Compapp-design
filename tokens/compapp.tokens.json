{
  "color": {
    "ground": { "$type": "color", "$value": "#F2F5EF", "$extensions": { "mode": { "dark": "#111915" } } },
    "surface": { "$type": "color", "$value": "#FFFFFF", "$extensions": { "mode": { "dark": "#18221C" } } },
    "surface-sunken": { "$type": "color", "$value": "#E8EEE6", "$extensions": { "mode": { "dark": "#0C120F" } } },
    "ink": { "$type": "color", "$value": "#1C2B22", "$extensions": { "mode": { "dark": "#E3ECE5" } } },
    "ink-muted": { "$type": "color", "$value": "#55635A", "$extensions": { "mode": { "dark": "#9DAEA3" } } },
    "line": { "$type": "color", "$value": "#CFD8CC", "$extensions": { "mode": { "dark": "#2C3A31" } } },
    "primary": { "$type": "color", "$value": "#3D7A52", "$extensions": { "mode": { "dark": "#8CCB9C" } } },
    "on-primary": { "$type": "color", "$value": "#FFFFFF", "$extensions": { "mode": { "dark": "#0E1A12" } } },
    "primary-soft": { "$type": "color", "$value": "#CFE6D3", "$extensions": { "mode": { "dark": "#24402D" } } },
    "presence-home": { "$type": "color", "$value": "#A9D4B2", "$extensions": { "mode": { "dark": "#3E7350" } } },
    "presence-away": { "$type": "color", "$value": "#5E6976", "$extensions": { "mode": { "dark": "#93A0AE" } } },
    "busy": { "$type": "color", "$value": "#9A5A0E", "$extensions": { "mode": { "dark": "#F0B866" } } },
    "busy-soft": { "$type": "color", "$value": "#F6D9A8", "$extensions": { "mode": { "dark": "#4A3416" } } },
    "danger": { "$type": "color", "$value": "#B3261E", "$extensions": { "mode": { "dark": "#F2B8B5" } } },
    "danger-soft": { "$type": "color", "$value": "#F6D5D2", "$extensions": { "mode": { "dark": "#5C1F1B" } } },
    "on-presence-away": { "$type": "color", "$value": "#FFFFFF", "$extensions": { "mode": { "dark": "#0E1A12" } }, "$description": "glyph on an away badge, on the presence-away fill" },
    "on-pebble": { "$type": "color", "$value": "#1C2B22", "$extensions": { "mode": { "dark": "#1C2B22" } }, "$description": "initials on a pebble: the pebble colors are pastel in both themes, so the text stays dark in both" }
  },
  "pebble": {
    "sage": { "$type": "color", "$value": "#BFE0C6" },
    "sky": { "$type": "color", "$value": "#C4DAF0" },
    "apricot": { "$type": "color", "$value": "#F6D3A8" },
    "rose": { "$type": "color", "$value": "#F2C6C2" },
    "sand": { "$type": "color", "$value": "#E6DDC4" },
    "tide": { "$type": "color", "$value": "#B9E2DD" }
  },
  "font": {
    "$extensions": {
      "tabularFigures": true,
      "opticalSizing": { "family": "Bricolage Grotesque", "axis": "opsz", "value": "fontSize", "min": 12, "max": 96 }
    },
    "display": { "$type": "typography", "$value": { "fontFamily": "Bricolage Grotesque", "fontWeight": 600, "fontSize": "40px", "lineHeight": "44px" } },
    "headline": { "$type": "typography", "$value": { "fontFamily": "Bricolage Grotesque", "fontWeight": 600, "fontSize": "28px", "lineHeight": "32px" } },
    "title": { "$type": "typography", "$value": { "fontFamily": "Bricolage Grotesque", "fontWeight": 600, "fontSize": "20px", "lineHeight": "26px" } },
    "body-lg": { "$type": "typography", "$value": { "fontFamily": "Instrument Sans", "fontWeight": 400, "fontSize": "17px", "lineHeight": "24px" } },
    "body": { "$type": "typography", "$value": { "fontFamily": "Instrument Sans", "fontWeight": 400, "fontSize": "15px", "lineHeight": "22px" } },
    "label": { "$type": "typography", "$value": { "fontFamily": "Instrument Sans", "fontWeight": 600, "fontSize": "13px", "lineHeight": "16px", "letterSpacing": "0.2px" } },
    "label-lg": { "$type": "typography", "$value": { "fontFamily": "Instrument Sans", "fontWeight": 600, "fontSize": "15px", "lineHeight": "22px" } },
    "pebble-xs": { "$type": "typography", "$value": { "fontFamily": "Instrument Sans", "fontWeight": 600, "fontSize": "12px", "lineHeight": "12px" } },
    "pebble-xs-pair": { "$type": "typography", "$value": { "fontFamily": "Instrument Sans", "fontWeight": 600, "fontSize": "10px", "lineHeight": "10px" } },
    "pebble-sm": { "$type": "typography", "$value": { "fontFamily": "Instrument Sans", "fontWeight": 600, "fontSize": "14px", "lineHeight": "14px" } },
    "pebble-md": { "$type": "typography", "$value": { "fontFamily": "Instrument Sans", "fontWeight": 600, "fontSize": "15px", "lineHeight": "12px" } },
    "pebble-lg": { "$type": "typography", "$value": { "fontFamily": "Instrument Sans", "fontWeight": 600, "fontSize": "20px", "lineHeight": "20px" } },
    "pebble-xl": { "$type": "typography", "$value": { "fontFamily": "Bricolage Grotesque", "fontWeight": 600, "fontSize": "28px", "lineHeight": "28px" } },
    "badge-count": { "$type": "typography", "$value": { "fontFamily": "Instrument Sans", "fontWeight": 600, "fontSize": "11px", "lineHeight": "18px" } },
    "badge-label": { "$type": "typography", "$value": { "fontFamily": "Instrument Sans", "fontWeight": 600, "fontSize": "12px", "lineHeight": "16px" } },
    "ring-label": { "$type": "typography", "$value": { "fontFamily": "Instrument Sans", "fontWeight": 600, "fontSize": "15px", "lineHeight": "15px" } },
    "caption": { "$type": "typography", "$value": { "fontFamily": "Instrument Sans", "fontWeight": 400, "fontSize": "12px", "lineHeight": "16px" } }
  },
  "space": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "16px" },
    "lg": { "$type": "dimension", "$value": "24px" },
    "xl": { "$type": "dimension", "$value": "32px" },
    "xxl": { "$type": "dimension", "$value": "48px" }
  },
  "radius": {
    "xs": { "$type": "dimension", "$value": "6px" },
    "sm": { "$type": "dimension", "$value": "10px" },
    "md": { "$type": "dimension", "$value": "16px" },
    "lg": { "$type": "dimension", "$value": "24px" },
    "pebble": { "$type": "number", "$value": 0.3, "$description": "fraction of the pebble size" }
  },
  "elevation": {
    "flat": {
      "$type": "border",
      "$value": { "color": "{color.line}", "width": "1px", "style": "solid" }
    },
    "sheet": {
      "$type": "shadow",
      "$value": { "color": "#1C2B22", "offsetX": "0px", "offsetY": "-8px", "blur": "32px", "spread": "0px" },
      "$extensions": { "opacity": 0.18, "colorToken": "color.ink" }
    }
  },
  "motion": {
    "presence": { "$type": "duration", "$value": "600ms", "$extensions": { "curve": "easeOut" } },
    "in-use": { "$type": "duration", "$value": "4000ms", "$extensions": { "curve": "easeInOut", "repeat": true } },
    "spin": { "$type": "duration", "$value": "1000ms", "$extensions": { "curve": "linear", "repeat": true } }
  },
  "target": {
    "min": { "$type": "dimension", "$value": "48px", "$extensions": { "drawn": "44px" } }
  },
  "size": {
    "control-md": { "$type": "dimension", "$value": "44px", "$description": "height of a medium button and chip" },
    "control-lg": { "$type": "dimension", "$value": "52px", "$description": "height of a large button and of a text field" },
    "glyph-md": { "$type": "dimension", "$value": "16px", "$description": "icon or spinner beside a medium label" },
    "glyph-lg": { "$type": "dimension", "$value": "18px", "$description": "icon or spinner beside a large label" },
    "border-emphasis": { "$type": "dimension", "$value": "2px", "$description": "selected, focused and error borders, spinner stroke" },
    "focus-ring": { "$type": "dimension", "$value": "4px", "$description": "primary-soft ring around a focused field" },
    "spinner-md": { "$type": "dimension", "$value": "12px", "$description": "ring of a spinner beside a medium label, drawn in a glyph-md box" },
    "spinner-lg": { "$type": "dimension", "$value": "13.5px", "$description": "ring of a spinner beside a large label, drawn in a glyph-lg box" },
    "dash": { "$type": "dimension", "$value": "4px", "$description": "dash of a dashed 1px border, scales with the border width" },
    "dash-gap": { "$type": "dimension", "$value": "3px", "$description": "gap of a dashed 1px border, scales with the border width" },
    "code-cell-width": { "$type": "dimension", "$value": "56px", "$description": "width of one code input cell, cells shrink to share a narrow column" },
    "code-cell-height": { "$type": "dimension", "$value": "60px", "$description": "height of one code input cell" },
    "pebble-xs": { "$type": "dimension", "$value": "28px", "$description": "side of the smallest pebble" },
    "pebble-sm": { "$type": "dimension", "$value": "36px", "$description": "side of a small pebble" },
    "pebble-md": { "$type": "dimension", "$value": "44px", "$description": "side of a medium pebble" },
    "pebble-lg": { "$type": "dimension", "$value": "56px", "$description": "side of a large pebble" },
    "pebble-xl": { "$type": "dimension", "$value": "72px", "$description": "side of the largest pebble, its initials use font.pebble-xl" },
    "pebble-badge": { "$type": "dimension", "$value": "20px", "$description": "side of the away and admin badges, drawn on a medium pebble and up" },
    "pebble-badge-glyph": { "$type": "dimension", "$value": "11px", "$description": "glyph inside pebble-badge" },
    "pebble-badge-offset": { "$type": "dimension", "$value": "4px", "$description": "how far a pebble badge hangs outside the pebble" },
    "border-dashed": { "$type": "dimension", "$value": "1.5px", "$description": "border of an invited pebble, drawn dashed" },
    "dot": { "$type": "dimension", "$value": "8px", "$description": "status dot beside a label" },
    "dot-unread": { "$type": "dimension", "$value": "10px", "$description": "unread dot, a little larger than dot" },
    "badge-count": { "$type": "dimension", "$value": "18px", "$description": "smallest side of a count badge, it grows with its text" },
    "badge-count-padding": { "$type": "dimension", "$value": "5px", "$description": "horizontal padding of a count badge" },
    "badge-label-radius": { "$type": "dimension", "$value": "8px", "$description": "corner radius of a label badge" },
    "ring": { "$type": "dimension", "$value": "56px", "$description": "side of a progress ring, it grows to hold a large label" },
    "ring-stroke": { "$type": "dimension", "$value": "4px", "$description": "stroke of a progress ring, track and arc" }
  },
  "state-layer": {
    "pressed-primary": { "$type": "number", "$value": 0.12, "$description": "ink over a primary fill when pressed" },
    "pressed-secondary": { "$type": "number", "$value": 0.08, "$description": "ink over a surface fill when pressed" },
    "pressed-danger": { "$type": "number", "$value": 0.16, "$description": "ink over a danger fill when pressed" },
    "spinner-track": { "$type": "number", "$value": 0.35, "$description": "track of a spinner drawn on a solid fill" }
  },
  "progress": {
    "ring-sweep": { "$type": "number", "$value": 0.3, "$description": "arc of an in-use ring with no known end, as a fraction of the circle" },
    "ring-breathe": { "$type": "number", "$value": 0.4, "$description": "lowest opacity of the arc while it breathes" }
  }
}
