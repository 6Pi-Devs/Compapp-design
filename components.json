{
  "$schema-version": 1,
  "components": [
    {
      "id": "app-button",
      "level": "atom",
      "class": "AppButton",
      "path": "atoms/app_button.dart",
      "props": [
        { "name": "label", "type": "String", "required": true },
        { "name": "onPressed", "type": "VoidCallback?", "required": true, "default": "null disables the button" },
        { "name": "variant", "type": "AppButtonVariant", "required": false, "default": "primary" },
        { "name": "size", "type": "AppButtonSize?", "required": false, "default": "lg (52); md (44) for ghost" },
        { "name": "icon", "type": "AppIcons?", "required": false },
        { "name": "loading", "type": "bool", "required": false, "default": "false" },
        { "name": "semanticLabel", "type": "String?", "required": false },
        { "name": "loadingSemanticLabel", "type": "String?", "required": false },
        { "name": "statesController", "type": "WidgetStatesController?", "required": false }
      ],
      "variants": ["primary-lg", "primary-md", "secondary-lg", "secondary-md", "ghost-md", "danger-lg", "danger-md"],
      "states": ["default", "pressed", "focus", "disabled", "loading"],
      "semantics": "Button named by label (semanticLabel replaces it), focusable and activatable. While loading it stays the same focusable button, ignores every activation (pointer, Enter and Space, semantic tap) and adds loadingSemanticLabel as its value in a live region",
      "key": "button.<action>",
      "stories": [
        "Atoms/AppButton/primary-lg-default",
        "Atoms/AppButton/primary-lg-pressed",
        "Atoms/AppButton/primary-lg-focus",
        "Atoms/AppButton/primary-lg-disabled",
        "Atoms/AppButton/primary-lg-loading",
        "Atoms/AppButton/primary-md-default",
        "Atoms/AppButton/primary-md-pressed",
        "Atoms/AppButton/primary-md-focus",
        "Atoms/AppButton/primary-md-disabled",
        "Atoms/AppButton/primary-md-loading",
        "Atoms/AppButton/secondary-lg-default",
        "Atoms/AppButton/secondary-lg-pressed",
        "Atoms/AppButton/secondary-lg-focus",
        "Atoms/AppButton/secondary-lg-disabled",
        "Atoms/AppButton/secondary-lg-loading",
        "Atoms/AppButton/secondary-md-default",
        "Atoms/AppButton/secondary-md-pressed",
        "Atoms/AppButton/secondary-md-focus",
        "Atoms/AppButton/secondary-md-disabled",
        "Atoms/AppButton/secondary-md-loading",
        "Atoms/AppButton/ghost-md-default",
        "Atoms/AppButton/ghost-md-pressed",
        "Atoms/AppButton/ghost-md-focus",
        "Atoms/AppButton/ghost-md-disabled",
        "Atoms/AppButton/ghost-md-loading",
        "Atoms/AppButton/danger-lg-default",
        "Atoms/AppButton/danger-lg-pressed",
        "Atoms/AppButton/danger-lg-focus",
        "Atoms/AppButton/danger-lg-disabled",
        "Atoms/AppButton/danger-lg-loading",
        "Atoms/AppButton/danger-md-default",
        "Atoms/AppButton/danger-md-pressed",
        "Atoms/AppButton/danger-md-focus",
        "Atoms/AppButton/danger-md-disabled",
        "Atoms/AppButton/danger-md-loading"
      ]
    },
    {
      "id": "app-icon",
      "level": "atom",
      "class": "AppIcon",
      "path": "atoms/app_icon.dart",
      "props": [
        { "name": "icon", "type": "AppIcons", "required": true },
        { "name": "size", "type": "double?", "required": false, "default": "IconTheme size, else 24" },
        { "name": "color", "type": "Color?", "required": false },
        { "name": "semanticLabel", "type": "String?", "required": false }
      ],
      "variants": ["gallery"],
      "states": ["default"],
      "semantics": "Decorative and excluded from semantics unless semanticLabel is non-empty, then an image with that label in its own node",
      "key": "none",
      "stories": ["Atoms/AppIcon/gallery-default"]
    },
    {
      "id": "app-chip",
      "level": "atom",
      "class": "AppChip",
      "path": "atoms/app_chip.dart",
      "props": [
        { "name": "label", "type": "String", "required": true },
        { "name": "onTap", "type": "VoidCallback?", "required": true, "default": "null disables the chip" },
        { "name": "selected", "type": "bool", "required": false, "default": "false" },
        { "name": "kind", "type": "AppChipKind", "required": false, "default": "room" }
      ],
      "variants": ["room", "item", "type"],
      "states": ["default", "selected", "disabled"],
      "semantics": "Button named by its label with a selected state; the check shown when selected is decorative",
      "key": "chip.<kind>.<id>",
      "stories": [
        "Atoms/AppChip/room-default",
        "Atoms/AppChip/room-selected",
        "Atoms/AppChip/room-disabled",
        "Atoms/AppChip/item-default",
        "Atoms/AppChip/item-selected",
        "Atoms/AppChip/item-disabled",
        "Atoms/AppChip/type-default",
        "Atoms/AppChip/type-selected",
        "Atoms/AppChip/type-disabled"
      ]
    },
    {
      "id": "app-switch",
      "level": "atom",
      "class": "AppSwitch",
      "path": "atoms/app_switch.dart",
      "props": [
        { "name": "value", "type": "bool", "required": true },
        { "name": "onChanged", "type": "ValueChanged<bool>?", "required": true, "default": "null disables the switch" },
        { "name": "label", "type": "String", "required": true }
      ],
      "variants": ["on", "off"],
      "states": ["default", "disabled"],
      "semantics": "One node with the label, a toggled state and a tap action; the track and the label toggle it",
      "key": "switch.<name>",
      "stories": [
        "Atoms/AppSwitch/on-default",
        "Atoms/AppSwitch/on-disabled",
        "Atoms/AppSwitch/off-default",
        "Atoms/AppSwitch/off-disabled"
      ]
    },
    {
      "id": "app-text-field",
      "level": "atom",
      "class": "AppTextField",
      "path": "atoms/app_text_field.dart",
      "props": [
        { "name": "label", "type": "String", "required": true },
        { "name": "controller", "type": "TextEditingController", "required": true },
        { "name": "hint", "type": "String?", "required": false },
        { "name": "helperText", "type": "String?", "required": false },
        { "name": "errorText", "type": "String?", "required": false },
        { "name": "obscure", "type": "bool", "required": false, "default": "false" },
        { "name": "revealSemanticLabel", "type": "String?", "required": false },
        { "name": "concealSemanticLabel", "type": "String?", "required": false },
        { "name": "keyboardType", "type": "TextInputType?", "required": false },
        { "name": "textInputAction", "type": "TextInputAction?", "required": false },
        { "name": "autofillHints", "type": "Iterable<String>?", "required": false },
        { "name": "enabled", "type": "bool", "required": false, "default": "true" },
        { "name": "autofocus", "type": "bool", "required": false, "default": "false" },
        { "name": "focusNode", "type": "FocusNode?", "required": false },
        { "name": "onChanged", "type": "ValueChanged<String>?", "required": false },
        { "name": "onSubmitted", "type": "ValueChanged<String>?", "required": false }
      ],
      "variants": ["text", "password"],
      "states": ["default", "filled", "focus", "error", "error-focus", "disabled"],
      "semantics": "One text field node named by the visible label, with the hint and value; invalid when errorText is set, and the error is a live region. The show/hide toggle of password is a button named by the label of its next action",
      "key": "field.<name>",
      "stories": [
        "Atoms/AppTextField/text-default",
        "Atoms/AppTextField/text-filled",
        "Atoms/AppTextField/text-focus",
        "Atoms/AppTextField/text-error",
        "Atoms/AppTextField/text-error-focus",
        "Atoms/AppTextField/text-disabled",
        "Atoms/AppTextField/password-default",
        "Atoms/AppTextField/password-filled",
        "Atoms/AppTextField/password-focus",
        "Atoms/AppTextField/password-error",
        "Atoms/AppTextField/password-error-focus",
        "Atoms/AppTextField/password-disabled"
      ]
    },
    {
      "id": "app-code-input",
      "level": "atom",
      "class": "AppCodeInput",
      "path": "atoms/app_code_input.dart",
      "props": [
        { "name": "label", "type": "String", "required": true },
        { "name": "onCompleted", "type": "ValueChanged<String>", "required": true },
        { "name": "length", "type": "int", "required": false, "default": "6" },
        { "name": "numeric", "type": "bool", "required": false, "default": "true" },
        { "name": "controller", "type": "TextEditingController?", "required": false },
        { "name": "errorText", "type": "String?", "required": false },
        { "name": "onChanged", "type": "ValueChanged<String>?", "required": false },
        { "name": "autofocus", "type": "bool", "required": false, "default": "false" },
        { "name": "focusNode", "type": "FocusNode?", "required": false }
      ],
      "variants": ["digits"],
      "states": ["empty", "partial", "filled", "error"],
      "semantics": "One text field node named by label whose value is the code entered so far, never one node per cell; invalid when errorText is set, and the error is a live region",
      "key": "codeInput.digit.<i>",
      "stories": [
        "Atoms/AppCodeInput/digits-empty",
        "Atoms/AppCodeInput/digits-partial",
        "Atoms/AppCodeInput/digits-filled",
        "Atoms/AppCodeInput/digits-error"
      ]
    },
    {
      "id": "app-pebble",
      "level": "atom",
      "class": "AppPebble",
      "path": "atoms/app_pebble.dart",
      "props": [
        { "name": "initials", "type": "String", "required": true },
        { "name": "joinOrder", "type": "int", "required": true, "default": "stable join sequence, not a list index; picks the color through AppColors.pebbleAt, wrapping after six" },
        { "name": "semanticLabel", "type": "String", "required": true },
        { "name": "size", "type": "AppPebbleSize", "required": false, "default": "s44" },
        { "name": "status", "type": "AppPebbleStatus", "required": false, "default": "home; away draws its badge only from s44 up" },
        { "name": "isYou", "type": "bool", "required": false, "default": "false" },
        { "name": "isAdmin", "type": "bool", "required": false, "default": "false; the key badge is drawn only from s44 up" }
      ],
      "variants": ["s28", "s36", "s44", "s56", "s72"],
      "states": ["home", "away", "invited", "you", "admin"],
      "semantics": "One image node named by semanticLabel (required, not empty), which holds the whole description (name, you, admin, away); the initials, the badges and the outline are excluded. A node of its own under a parent that does not merge; under a parent that merges its children (a MergeSemantics row) its label joins the row's. Status and role are drawn as shapes: moon badge (away), dashed outline without fill (invited), key badge (admin), inset dark ring (you). The away and admin badges are drawn only from s44 up: on s28 and s36 they are left out, so say them in semanticLabel and in the text next to the pebble. The away badge hangs at the bottom trailing corner and the admin key at the top trailing corner (the board puts the key at the bottom too, where it would cover the status badge). The pebble is always a square: exactly its side at text scale 1, growing continuously with larger text. Two initials up to MW fit at every size; wider pairs (WW) grow s28 and s36 by a pixel or two. From s44 up the side reserves room for the badge squares in every state, so pebbles of a size stay equal. On s44+ a badge may cover the tip of an accent or a descender on two-letter initials; capitals are never covered",
      "key": "pebble.<accountId>, pebble.badge.away, pebble.badge.admin",
      "stories": [
        "Atoms/AppPebble/s28-home",
        "Atoms/AppPebble/s28-away",
        "Atoms/AppPebble/s28-invited",
        "Atoms/AppPebble/s28-you",
        "Atoms/AppPebble/s28-admin",
        "Atoms/AppPebble/s36-home",
        "Atoms/AppPebble/s36-away",
        "Atoms/AppPebble/s36-invited",
        "Atoms/AppPebble/s36-you",
        "Atoms/AppPebble/s36-admin",
        "Atoms/AppPebble/s44-home",
        "Atoms/AppPebble/s44-away",
        "Atoms/AppPebble/s44-invited",
        "Atoms/AppPebble/s44-you",
        "Atoms/AppPebble/s44-admin",
        "Atoms/AppPebble/s56-home",
        "Atoms/AppPebble/s56-away",
        "Atoms/AppPebble/s56-invited",
        "Atoms/AppPebble/s56-you",
        "Atoms/AppPebble/s56-admin",
        "Atoms/AppPebble/s72-home",
        "Atoms/AppPebble/s72-away",
        "Atoms/AppPebble/s72-invited",
        "Atoms/AppPebble/s72-you",
        "Atoms/AppPebble/s72-admin"
      ]
    },
    {
      "id": "app-status-dot",
      "level": "atom",
      "class": "AppStatusDot",
      "path": "atoms/app_status_dot.dart",
      "props": [
        { "name": "status", "type": "AppDotStatus", "required": true }
      ],
      "variants": ["dot"],
      "states": ["home", "away", "busy", "unread"],
      "semantics": "Decorative and excluded from semantics: the dot has no label. It always sits next to the text that names the status and is never the only cue (home and busy differ only by hue), so it must never stand alone",
      "key": "none",
      "stories": [
        "Atoms/AppStatusDot/dot-home",
        "Atoms/AppStatusDot/dot-away",
        "Atoms/AppStatusDot/dot-busy",
        "Atoms/AppStatusDot/dot-unread"
      ]
    },
    {
      "id": "app-badge",
      "level": "atom",
      "class": "AppBadge",
      "path": "atoms/app_badge.dart",
      "props": [
        { "name": "count", "type": "int?", "required": false, "default": "AppBadge.count: the number, 99+ beyond 99" },
        { "name": "label", "type": "String?", "required": false, "default": "AppBadge.label: a short text" },
        { "name": "tone", "type": "AppBadgeTone", "required": false, "default": "primary for count, soft for label" },
        { "name": "semanticLabel", "type": "String?", "required": false, "default": "replaces the visible text for assistive technology" }
      ],
      "variants": ["count", "overflow", "label"],
      "states": ["primary", "busy", "soft"],
      "semantics": "The visible number or label is read as it is. With semanticLabel the badge is one labeled node (\"3 unread\") and its text is excluded. Like any semantic child it merges into a parent that merges its children (a MergeSemantics row reads the row label and the badge label as one); under a parent that does not merge it is a node of its own. Text reaches 4.5:1 on every fill; the fill carries no meaning. Callers hide the badge at 0",
      "key": "none",
      "stories": [
        "Atoms/AppBadge/count-primary",
        "Atoms/AppBadge/count-busy",
        "Atoms/AppBadge/count-soft",
        "Atoms/AppBadge/overflow-primary",
        "Atoms/AppBadge/overflow-busy",
        "Atoms/AppBadge/overflow-soft",
        "Atoms/AppBadge/label-primary",
        "Atoms/AppBadge/label-busy",
        "Atoms/AppBadge/label-soft"
      ]
    },
    {
      "id": "app-progress-ring",
      "level": "atom",
      "class": "AppProgressRing",
      "path": "atoms/app_progress_ring.dart",
      "props": [
        { "name": "semanticLabel", "type": "String?", "required": true, "default": "null leaves the ring out of semantics" },
        { "name": "value", "type": "double?", "required": false, "default": "null: in use with no known end, a breathing arc; 0 to 1 otherwise, clamped; must be finite" },
        { "name": "tone", "type": "AppRingTone", "required": false, "default": "primary" },
        { "name": "size", "type": "double", "required": false, "default": "AppSizes.ring (56); grows with a large label" },
        { "name": "label", "type": "String?", "required": false, "default": "text in the middle" },
        { "name": "semanticValue", "type": "String?", "required": false, "default": "required with a value, for example 11 of 15 done" }
      ],
      "variants": ["indeterminate", "determinate"],
      "states": ["busy", "primary"],
      "semantics": "With a semanticLabel the ring is one node: the label names what it measures and, with a value, semanticValue says how far it is (an in-use ring never has a value); the drawing and the middle label are excluded. Null excludes the ring. Like any semantic child it merges into a parent that merges its children. The arc breathes only when animations are enabled, and stands still at full opacity otherwise. A value that is not finite is drawn as 0",
      "key": "none",
      "stories": [
        "Atoms/AppProgressRing/indeterminate-busy",
        "Atoms/AppProgressRing/indeterminate-primary",
        "Atoms/AppProgressRing/determinate-busy",
        "Atoms/AppProgressRing/determinate-primary"
      ]
    }
  ]
}
